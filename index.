<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SportFit - Roupas Esportivas</title>

    <style>
        :root {
            --verde: #1ecb7c;
            --verde-escuro: #0e8b5d;
            --preto: #121212;
            --cinza: #f4f6f4;
            --cinza-escuro: #4d4d4d;
            --branco: #ffffff;
            --sombra: 0 12px 30px rgba(18, 18, 18, 0.12);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--cinza);
            color: var(--preto);
        }

        img {
            display: block;
            width: 100%;
        }

        a {
            text-decoration: none;
        }

        header {
            background: rgba(18, 18, 18, 0.95);
            color: var(--branco);
            position: sticky;
            top: 0;
            z-index: 10;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            backdrop-filter: blur(12px);
        }

        header h1 {
            color: var(--verde);
            font-size: 2rem;
            letter-spacing: 1px;
        }

        nav {
            display: flex;
            gap: 26px;
            flex-wrap: wrap;
        }

        nav a {
            color: var(--branco);
            font-weight: bold;
            transition: color 0.2s ease;
        }

        nav a:hover {
            color: var(--verde);
        }

        .banner {
            background: linear-gradient(rgba(18,18,18,0.45), rgba(14, 139, 93, 0.65)),
                        url('https://images.unsplash.com/photo-1517836357463-d25dfeac3438?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
            color: var(--branco);
            padding: 110px 20px 80px;
            text-align: center;
        }

        .banner-content {
            max-width: 900px;
            margin: 0 auto;
        }

        .tag {
            display: inline-block;
            background: rgba(30, 203, 124, 0.2);
            border: 1px solid rgba(255,255,255,0.25);
            color: #d7ffe9;
            padding: 8px 16px;
            border-radius: 999px;
            font-size: 0.8rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 18px;
        }

        .banner h2 {
            font-size: clamp(2.4rem, 6vw, 4.4rem);
            margin-bottom: 14px;
        }

        .banner p {
            font-size: 1.2rem;
            max-width: 700px;
            margin: 0 auto 26px;
            line-height: 1.6;
        }

        .botoes {
            display: flex;
            justify-content: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .botao {
            display: inline-block;
            background: var(--verde);
            color: var(--preto);
            padding: 15px 28px;
            border-radius: 999px;
            font-weight: bold;
            transition: transform 0.2s ease, background 0.2s ease;
        }

        .botao:hover {
            background: #49d996;
            transform: translateY(-2px);
        }

        .botao-secundario {
            background: transparent;
            border: 2px solid rgba(255,255,255,0.7);
            color: var(--branco);
        }

        section {
            padding: 70px 8%;
        }

        .titulo {
            text-align: center;
            margin-bottom: 35px;
            font-size: clamp(2rem, 4vw, 2.8rem);
        }

        .colecoes {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 22px;
            margin-top: 25px;
        }

        .colecao {
            position: relative;
            min-height: 260px;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: var(--sombra);
        }

        .colecao img {
            height: 100%;
            object-fit: cover;
        }

        .colecao .overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(18,18,18,0.12), rgba(18,18,18,0.8));
            display: flex;
            align-items: end;
            padding: 24px;
            color: var(--branco);
        }

        .colecao h3 {
            font-size: 1.5rem;
        }

        .produtos {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 25px;
        }

        .produto {
            background: var(--branco);
            border-radius: 18px;
            overflow: hidden;
            box-shadow: var(--sombra);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .produto:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 32px rgba(18,18,18,0.18);
        }

        .produto img {
            height: 260px;
            object-fit: cover;
            filter: saturate(1.12) contrast(1.04);
        }

        .produto-info {
            padding: 20px;
        }

        .categoria {
            display: inline-block;
            font-size: 0.74rem;
            color: var(--verde-escuro);
            background: rgba(30, 203, 124, 0.1);
            padding: 6px 10px;
            border-radius: 999px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .produto h3 {
            margin-bottom: 8px;
            font-size: 1.35rem;
        }

        .produto p {
            color: var(--cinza-escuro);
            min-height: 48px;
            line-height: 1.5;
            margin-bottom: 16px;
        }

        .produto-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .preco {
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--verde-escuro);
        }

        .qualidade {
            background: linear-gradient(135deg, #0c0c0c, #1f3a34);
            color: var(--branco);
            text-align: center;
        }

        .qualidade p {
            max-width: 900px;
            margin: 0 auto;
            font-size: 1.08rem;
            line-height: 1.8;
        }

        .beneficios {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }

        .beneficio {
            background: var(--branco);
            padding: 26px 22px;
            border-radius: 16px;
            box-shadow: var(--sombra);
            text-align: center;
        }

        .beneficio .icone {
            width: 70px;
            height: 70px;
            margin: 0 auto 18px;
            border-radius: 50%;
            background: rgba(30, 203, 124, 0.1);
            display: grid;
            place-items: center;
            font-size: 2rem;
        }

        .beneficio h3 {
            color: var(--verde-escuro);
            margin-bottom: 10px;
        }

        .galeria {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 20px;
        }

        .galeria img {
            height: 280px;
            object-fit: cover;
            border-radius: 18px;
            box-shadow: var(--sombra);
            filter: saturate(1.15) contrast(1.05);
        }

        .newsletter {
            background: #eafaf3;
            border-radius: 22px;
            padding: 35px 24px;
            text-align: center;
            box-shadow: var(--sombra);
        }

        .newsletter h3 {
            font-size: 2rem;
            margin-bottom: 10px;
        }

        .newsletter p {
            color: var(--cinza-escuro);
            margin-bottom: 22px;
        }

        .newsletter-form {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .newsletter-form input {
            width: min(420px, 100%);
            padding: 16px 18px;
            border: 1px solid #d5e4dc;
            border-radius: 999px;
            font-size: 1rem;
        }

        footer {
            background: var(--preto);
            color: var(--branco);
            text-align: center;
            padding: 28px 20px;
        }

        footer h3 {
            margin-bottom: 10px;
            color: var(--verde);
        }

        footer p {
            margin-bottom: 8px;
            color: #d7d7d7;
        }

        @media (max-width: 680px) {
            header {
                flex-direction: column;
                gap: 14px;
            }

            nav {
                justify-content: center;
            }

            .galeria {
                grid-template-columns: 1fr;
            }

            .newsletter-form {
                flex-direction: column;
            }

            .newsletter-form input,
            .newsletter-form .botao {
                width: 100%;
            }
        }
    </style>
</head>

